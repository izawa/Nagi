      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume"
          }
        }
      }
    },
    "再開するまで": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until Resumed"
          }
        }
      }
    },
    "再開するまで一時停止中": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused Until Resumed"
          }
        }
      }
    },
