      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagi (Paused)"
          }
        }
      }
    },
    "凪へようこそ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Nagi"
          }
        }
      }
    },
    "動画の再生中は出さない": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide While Video Plays"
          }
        }
      }
    },
    "始める": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start"
          }
        }
      }
    },
    "手を止めてから現れるまで": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appears After Hands Rest For"
          }
        }
      }
    },
    "推奨に戻す": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore Recommended"
          }
        }
      }
    },
    "日の光で描くので、日が沈むと現れません。月が出ている夜は、月明かりで薄く現れます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is drawn with sunlight, so it does not appear after sunset. On nights with a moon, it appears faintly by moonlight."
          }
        }
      }
    },
    "深まる速さ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deepening"
          }
        }
      }
    },
    "画面共有と画面収録に写す": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in Screen Sharing and Recording"
          }
        }
      }
    },
    "設定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
