    },
    "日が沈んでいます。木漏れ日は月明かりで薄く現れます": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun has set. Komorebi appears faintly by moonlight."
          }
        }
